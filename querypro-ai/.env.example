# Copy this file to .env and fill in your key to enable real AI generation
# in /api/generate (used by SQL Studio's chat panel and the AI SQL Generator page).

# Prisma / Supabase database connection strings
# DATABASE_URL: use the pooled connection string from Supabase
# Project Settings → Database → Connection string, using port 6543.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true

# DIRECT_URL: use the direct connection string from Supabase
# Project Settings → Database → Connection string, using port 5432.
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

GROQ_API_KEY=
# Optional — defaults to llama3-70b-8192 (or llama3-8b-8192)
GROQ_MODEL=llama3-70b-8192
