# Copy this file to .env.local and fill in your key to enable real AI generation
# in /api/generate (used by SQL Studio's chat panel and the AI SQL Generator page).
#
# Without this key, /api/generate automatically falls back to the app's built-in
# mock SQL generator — the UI and streaming behavior work identically either way,
# so the app is fully demoable with zero configuration.

OPENAI_API_KEY=
